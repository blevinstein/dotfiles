# ignore all by default
*

# include dotfiles
!.astylerc
!.bash
!.bash/local
!.bash/local/*
!.bash_compat
!.bash_linux
!.bash_osx
!.bash_profile
!.bashrc
!.emacs
!.emacs.d
!.gitconfig
!.gitignore
!.gitignore_global
!.gitmodules
!.inputrc
!.racketrc
!.screenrc
!.tmux.conf
!.tmux/plugins
!.vim
!.vim/plugged
!.vim/plugged/vim-gitgutter
!.vim/plugged/vim-gitgutter/**
!.vimrc

!Readme.md

# tools
!tools
!tools/**
tools/**/node_modules

# setup
!setup.sh

# claude skills generally source-controlled, with some exceptions...
!.claude/
!.claude/skills/
!.claude/skills/**
# installed by peon-ping https://github.com/PeonPing/peon-ping
.claude/skills/peon-ping-*/**
# folder used by codex for configuration
.claude/skills/.system
!.claude/rules
!.claude/rules/**
# hooks config; note peon-ping's own entries use machine-specific absolute
# paths written by its installer, so they won't transfer verbatim to a
# fresh machine -- rerun the peon-ping installer there to regenerate them
!.claude/settings.json

# cursor
!.cursor
.cursor/projects
.cursor/skills-cursor
.cursor/plugins
.cursor/plans
!.cursor/rules
!.cursor/rules/**
!.cursor/hooks.json
!.cursor/hooks
!.cursor/hooks/**

# codex
# this is a symlink to .claude/skills so that codex gets the same skills
!.codex
!.codex/skills/

# gemini/antigravity
!.gemini
!.gemini/config
!.gemini/config/skills.json
!.gemini/config/AGENTS.md
