#!/usr/bin/env bash
# bash config shared across platforms

# CONFIG

# don't put duplicate lines or lines starting with space in the history.
HISTCONTROL=ignoreboth
# append to the history file, don't overwrite it
shopt -s histappend
# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=10000
HISTFILESIZE=10000
# open multiple files in vim using vertical panes
alias vim="vim -O"
export EDITOR="vim"
# open emacs without GUI
alias emacs="emacs -nw"
alias git_get_branch="git rev-parse --abbrev-ref HEAD"
# ant colorized output
alias ant="ant -logger org.apache.tools.ant.listener.AnsiColorLogger"
alias mkdir="mkdir -p"

# Bash prompt
# git aware prompt
export GITAWAREPROMPT=~/.bash/git-aware-prompt
source $GITAWAREPROMPT/main.sh

# local scripts should call set_bash_prompt after updating LOCAL_PS1_PREFIX
function set_bash_prompt {
  export PS1="$LOCAL_PS1_PREFIX\[$txtrst\]\[$bldgrn\]\u@$HOSTNAME:\[$bldblu\]\w \[$txtcyn\]\$git_branch\[$txtred\]\$git_dirty\[$txtrst\]\n\$ "
}
set_bash_prompt


# SHORTCUTS

# ^j -> jobs
bind -x '"\C-j":jobs'
# ^r -> fg ("resume")
bind -x '"\C-r":fg'

# TOOLS

export PATH=$HOME/tools:$PATH

# BINARIES

export PATH=$HOME/bin:$PATH

# Color stuff copied from https://gist.github.com/brandonb927/3195465
black='\033[0;30m'
white='\033[0;37m'
red='\033[0;31m'
green='\033[0;32m'
yellow='\033[0;33m'
blue='\033[0;34m'
magenta='\033[0;35m'
cyan='\033[0;36m'

# Color reset
alias uncolor='tput sgr0'

# Color echo
# Usage: cecho <message> <color>
function cecho {
  color=$2
  echo "$color$1"
  uncolor
  return
}

# Usage: git_diff_edit <filename>
# Edit a file with git diffs visible.
function git_diff_edit {
  if [ $1 ]; then
    temp="/tmp/diff.$$.tmp"
    git diff -R $1 > "$temp"
    vim $1 +"vertical diffpatch $temp"
    rm $temp
  else
    echo "No filename provided."
  fi
}

# screen commands

# List all running screen sessions
# Usage: sl
alias sl="screen -list"

# Start a new screen session
# Usage: ss <session_name>
alias ss="screen -S"

# Reattach a running screen session
# Usage: sr <session_name>
alias sr="screen -r"

# Execute a command in a running screen session
function sx {
  if [ "$#" -ge 2 ]; then
    # "stuff" is a screen command
    command="${@:2}"
    screen -r $1 -X stuff "$command\r"
  else
    echo "Too few arguments."
    echo "Usage: sx <session> <command...>"
  fi
}

# tmux commands

# List all running tmux sessions
# Usage: tl
alias tl="tmux list-sessions"

# Create a new tmux session
# NOTE: Append "-r" for readonly
# NOTE: Append "-t [target-session]" to group with target-session
function ts {
  if [ $1 ]; then
    tmux_cmd="tmux new-session -s '$1' ${@:2}"
  else
    tmux_cmd="tmux new-session ${@:1}"
  fi
  echo "$tmux_cmd"
  eval "$tmux_cmd"
}

# Reattach a running tmux session
# Usage: tt <session_name>
# NOTE: "tr" conflicts with http://ss64.com/bash/tr.html
alias tt="tmux attach -t"

# Reattach a running tmux session in readonly mode
# Usage: ttr <session_name>
alias ttr="tmux attach -r -t"

# Execute commands in a running tmux session
# Usage: tx <session_name> <command...>
function tx {
  if [ "$#" -ge 2 ]; then
    # TODO: Offer optional send-keys -R (reset terminal state)
    tmux_cmd="tmux send-keys -t '$1' '${@:2}' C-m"
    echo "$tmux_cmd"
    eval "$tmux_cmd"
  else
    echo "Too few arguments."
    echo "Usage: tx <session> <command...>"
  fi
}

# Create a new window in an existing tmux session
alias tn="tmux new-window -t"

# Kill a tmux session
# NOTE: "Ctrl-A &" to kill a single window
# NOTE: "Ctrl-A x" to kill a single pane
alias tkill="tmux kill-session -t"

# dump full tmux pane scrollback to a file (~/tools/save-pane.sh)
function tsave {
  ~/tools/save-pane.sh "$@"
}

# Prints a comma-delimited list
function comma() {
  local IFS=,
  echo "$*"
}

# Prints a colon-delimited list
function colon() {
  local IFS=:
  echo "$*"
}

# Prints a space-delimited list
function space() {
  local IFS=" "
  echo "$*"
}

# Node-related

function npm-do() {
(PATH=$(npm bin):$PATH; eval $@;)
}

if [[ -d "$HOME/.nvm" ]]; then
  export NVM_DIR="$HOME/.nvm"
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
  [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
fi

# Used for fixing copy/paste behavior when claude screws up a terminal
alias fixpaste='printf "\e[?2004l"'

# ~/tools launchers

# Jira ticket creator (~/tools/new-ticket/)
function new-ticket {
  node ~/tools/new-ticket/index.js
}

# arborist: git worktree + tmux TUI (~/tools/arborist/)
# reads $WORKTREE_HOME (set per-machine in ~/.bash_local) as the default parent
# dir for new worktrees: $WORKTREE_HOME/<repo>/<branch>
function arb {
  node ~/tools/arborist/index.js "$@"
}

# Spin up a dedicated worktree and launch the cursor agent
workagent() {
    local feature_name=$1
    local base_branch=$2
    local agent=${AGENT:-agent}

    if [ -z "$feature_name" ]; then
        echo "Usage: workagent <feature-name> [base-branch]"
        return 1
    fi

    local target_path="$HOME/.agent/worktrees/${feature_name}"

    if [ ! -d "$target_path" ]; then
        if [ "$feature_name" = "$base_branch" ]; then
            echo "Creating worktree for '$base_branch'..."
            git worktree add "$target_path" "$base_branch"
        else
            echo "Creating new worktree branch '$feature_name' based on '$base_branch'..."
            git worktree add "$target_path" -b "$feature_name" $base_branch
        fi
    else
        echo "Worktree exists. Reusing..."
    fi

    pushd "$target_path"
    "$agent"
    popd
}

# CloudCLI (Claude Code / Cursor CLI / Codex web UI), loopback-only on :3001
# Relies on lsof to find the listening pid, which ships by default on macOS
# but not on every Linux distro/container base image.
# TODO(linux): confirm `lsof` is present on target linux hosts; install via
# `apt install lsof` / `apk add lsof` / `dnf install lsof` if the guard below
# ever fires there.
function cloudcli-start {
  if ! command -v lsof >/dev/null 2>&1; then
    echo "cloudcli-start needs 'lsof' on PATH (not found)."
    return 1
  fi
  if lsof -iTCP:3001 -sTCP:LISTEN -n -P -t >/dev/null 2>&1; then
    echo "cloudcli already running on http://127.0.0.1:3001 (pid $(lsof -iTCP:3001 -sTCP:LISTEN -n -P -t))"
    return 0
  fi
  HOST=127.0.0.1 nohup cloudcli --port 3001 > /tmp/cloudcli.log 2>&1 &
  disown
  echo "cloudcli starting on http://127.0.0.1:3001 (pid $!) — logs: /tmp/cloudcli.log"
}

function cloudcli-stop {
  if ! command -v lsof >/dev/null 2>&1; then
    echo "cloudcli-stop needs 'lsof' on PATH (not found)."
    return 1
  fi
  local pid
  pid=$(lsof -iTCP:3001 -sTCP:LISTEN -n -P -t 2>/dev/null)
  if [ -z "$pid" ]; then
    echo "cloudcli is not running"
    return 0
  fi
  kill "$pid" && echo "stopped cloudcli (pid $pid)"
}

function cloudcli-restart {
  cloudcli-stop
  sleep 1
  cloudcli-start
}
